# Web UI Configuration
SECRET_KEY=change-this-secret-key-in-production-use-a-random-string
WEBUI_PASSWORD=your-secure-password-here
# WEBUI_PASSWORD_HASH=   # Optional: pre-hashed password (overrides WEBUI_PASSWORD)
#                          Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"

# Router Configuration (use one method)
# Method 1: Comma-separated lists
# ROUTER_HOSTS=192.168.1.1,192.168.1.2
# ROUTER_PASSES=password1,password2

# Method 2: Numbered variables (recommended for multiple routers)
ROUTER_HOST_1=192.168.1.1
ROUTER_PASS_1=your-router-password-1
ROUTER_NAME_1=Home Router

ROUTER_HOST_2=192.168.1.2
ROUTER_PASS_2=your-router-password-2
ROUTER_NAME_2=Office Router

# ROUTER_HOST_3=192.168.1.3
# ROUTER_PASS_3=your-router-password-3
# ROUTER_NAME_3=Guest Router

# AdGuard Home (YouTube / Roblox block)
# Default: uses router proxy (root + router password) at http://router/control/ — no extra config needed.
# Set these only if using the direct AdGuard API (host:3000) with a dedicated AdGuard admin account:
# ADGUARD_PASSWORD=your-adguard-admin-password
# ADGUARD_USERNAME=admin   # optional; defaults to trying admin then root

# OIDC / Authentik single sign-on
# Set OIDC_ENABLED=true to replace the password form with a "Login with Authentik" button.
# Set OIDC_ENABLED=false (or omit) to use password authentication.
# OIDC_ENABLED=false
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/glinet-block/.well-known/openid-configuration
